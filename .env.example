# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/setofdecore

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Auth
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Store
NEXT_PUBLIC_SITE_URL=https://setofdecore.store
